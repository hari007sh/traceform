# AgentStack Configuration

# Server
PORT=8080
GATEWAY_PORT=8090
ENVIRONMENT=development  # development | production
LOG_LEVEL=info           # debug | info | warn | error

# Database
DATABASE_URL=postgresql://agentstack:agentstack_dev@localhost:5432/agentstack?sslmode=disable
CLICKHOUSE_URL=clickhouse://localhost:9000/agentstack
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
ENCRYPTION_KEY=  # 64-char hex string for AES-256-GCM
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=  # comma-separated additional origins (auto-includes FRONTEND_URL)

# Ingestion
INGEST_BATCH_SIZE=10000
INGEST_FLUSH_INTERVAL_MS=5000
INGEST_MAX_BUFFER_SIZE=50000
INGEST_MAX_RETRIES=3
DEAD_LETTER_PATH=/tmp/agentstack/deadletter
DEFAULT_SAMPLE_RATE=1.0

# Rate Limiting
RATE_LIMIT_DEFAULT=1000    # requests/min for query endpoints
RATE_LIMIT_INGEST=10000    # requests/min for ingest endpoints

# Connection Pools
PG_MAX_OPEN_CONNS=25
PG_MAX_IDLE_CONNS=15
CH_MAX_OPEN_CONNS=25
CH_MAX_IDLE_CONNS=15

# Email (for alerts)
SENDGRID_API_KEY=
FROM_EMAIL=alerts@agentstack.dev

# Storage
BLOB_STORE_TYPE=filesystem
BLOB_STORE_PATH=/tmp/agentstack/payloads

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
